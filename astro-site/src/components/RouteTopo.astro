---
// The research "route topo": not my career, but the problem I'm climbing.
// The holds connect data, learning signals, memory, and exploration.
// The top represents the long-term goal of self-improving AI.
// Holds are drawn as irregular blobs with bolt holes, like a real spray wall.
---
<svg viewBox="0 0 340 268" role="img" aria-label="Research interests drawn as a bouldering route connecting data, learning signals, memory, exploration, and self-improving AI" style="width:100%;height:auto;display:block">
  <title>The line: data → signal → memory → exploration → self-improving AI</title>
  <path d="M62 232 C 95 214, 118 202, 135 182 C 152 162, 122 142, 112 124 C 102 106, 160 98, 192 86 C 224 74, 244 52, 262 34"
        fill="none" stroke="var(--faint)" stroke-width="2" stroke-dasharray="6 6" opacity="0.7"/>

  <!-- data and learning signal -->
  <g transform="rotate(-12 62 232)">
    <!-- jug -->
    <path d="M45 236 C42 226 49 217 61 216 C74 215 81 222 80 231 C79 241 71 248 60 247 C51 246 47 243 45 236 Z"
          fill="var(--hold-coral)"/>
    <circle cx="62" cy="231" r="2.4" fill="var(--bg)" opacity="0.85"/>
  </g>
  <text x="88" y="237" font-size="11" fill="var(--muted)">data · what to learn from</text>

  <g transform="rotate(16 135 182)">
    <!-- sloper -->
    <path d="M118 187 C117 178 125 171 136 171 C147 171 153 176 152 183 C151 190 143 194 133 193 C125 192 119 191 118 187 Z"
          fill="var(--hold-amber)"/>
    <circle cx="135" cy="182" r="2.4" fill="var(--bg)" opacity="0.85"/>
  </g>
  <text x="160" y="187" font-size="11" fill="var(--muted)">signal · how to weight it</text>

  <!-- memory and exploration -->
  <g transform="rotate(-20 112 124)">
    <!-- crimp -->
    <path d="M96 128 C94 121 101 114 112 114 C123 114 129 118 128 125 C127 131 120 135 110 134 C102 133 97 132 96 128 Z"
          fill="var(--hold-purple)" fill-opacity="0.3" stroke="var(--hold-purple)" stroke-width="2"/>
    <circle cx="112" cy="124" r="2.2" fill="var(--bg)" opacity="0.85"/>
  </g>
  <text x="137" y="129" font-size="11" fill="var(--muted)">memory · where learning lives</text>

  <g transform="rotate(9 192 86)">
    <!-- pinch -->
    <path d="M179 92 C176 83 182 74 192 73 C202 73 208 79 207 88 C206 96 199 100 190 98 C184 97 181 96 179 92 Z"
          fill="var(--hold-teal)" fill-opacity="0.3" stroke="var(--hold-teal)" stroke-width="2"/>
    <circle cx="192" cy="86" r="2.2" fill="var(--bg)" opacity="0.85"/>
  </g>
  <text x="167" y="91" font-size="11" fill="var(--muted)" text-anchor="end">exploration · the crux</text>

  <!-- chalk smudges -->
  <ellipse cx="83" cy="222" rx="6" ry="2.5" fill="var(--faint)" opacity="0.18" transform="rotate(-18 83 222)"/>
  <ellipse cx="152" cy="170" rx="5" ry="2" fill="var(--faint)" opacity="0.15" transform="rotate(12 152 170)"/>

  <!-- long-term goal -->
  <g transform="rotate(-8 262 34)">
    <path d="M248 38 C246 28 254 21 263 21 C273 21 279 27 277 36 C276 44 268 48 260 46 C253 45 249 43 248 38 Z"
          fill="none" stroke="var(--hold-pink)" stroke-width="2.2" stroke-dasharray="4 4"/>
  </g>
  <text x="262" y="12" font-size="11" fill="var(--hold-pink)" text-anchor="middle">self-improving AI</text>
</svg>
